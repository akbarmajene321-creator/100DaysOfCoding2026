import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        
        System.out.print("Masukkan angka : ");
        int a = input.nextInt();
        System.out.print("Masukkan pangkat : ");
        int b = input.nextInt();
        int c = 1;
        for (int i = 0; i < b; i++) {
            c *= a;
        }
        System.out.println(c);
    }
}
