public class Main{
    public static int cari(int[] arr, int target) {
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == target) {
                return i; 
            }
        }
        return -1; 
    }

    public static void main(String[] args) {
        int[] data = {5, 3, 8, 1, 9, 2, 7};
        
        int target = 9;
        
        int hasil = cari(data, target);
        
        if (hasil != -1) {
            System.out.println("Elemen " + target + " ditemukan pada indeks " + hasil);
        } else {
            System.out.println("Elemen " + target + " tidak ditemukan");
        }
    }
}
