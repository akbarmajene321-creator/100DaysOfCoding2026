import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        
        System.out.print("Masukkan nilai n: ");
        int n = input.nextInt();
        int a = 1; 
        
        for (int i = 1; i <= n; i++) {
            a *= i;
        }
        System.out.println("Hasil perkalian 1 sampai " + n + " = " + a);
    }
}
