import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("=== DAFTAR AKUN ===");
        System.out.print("Buat username : ");
        String username = sc.nextLine();
        System.out.print("Buat password : ");
        String password = sc.nextLine();

        System.out.println("Akun berhasil dibuat!\n");
        System.out.println("=== LOGIN ===");

        boolean isLoginBerhasil = false;
        int percobaan = 0;

        while (!isLoginBerhasil) {
            System.out.print("Username : ");
            String d = sc.nextLine();
            System.out.print("Password : ");
            String e = sc.nextLine();
            percobaan++;

            if (username.equals(d) && password.equals(e)) {
                isLoginBerhasil = true;
                System.out.println("Login berhasil! Selamat datang, " + username);
                System.out.println("Jumlah percobaan login : " + percobaan);
            } else {
                System.out.println("Username atau password salah, coba lagi.\n");
            }
        }

        sc.close();
    }
}
