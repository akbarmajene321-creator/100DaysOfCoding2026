import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        System.out.print("masukkan temperatur ruangan (°C)");
        double a = sc.nextDouble();
        
        if (a < 16) {
            System.out.println("Ruangan Dingin");
        } else if (a >= 16 && a < 25) {
            System.out.println("Ruangan Agak Dingin");
        } else if (a >= 26 && a < 30) {
            System.out.println("Ruangan Sejuk ");
        } else if (a >= 31 && a < 35 ) {
            System.out.println("Ruangan Hangat");
        } else if (a >= 36 && a < 40) {
            System.out.println("Ruangan Panas");
        } else {
            System.out.println("Ruangan sangat Panas");
        }
    }
}
