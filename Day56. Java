import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Masukkan Nilai N: ");
        int N = sc.nextInt();
        
        System.out.println("\n=== 1-N ===");
        for (int a = 1; a <= N; a++) {
            
            System.out.print(a+" ");
        } 
        
        System.out.println("\n\n=== N-1 ===");
        for (int b = N; b >= 1; b--) {
            
            System.out.print(b+" ");
        } 
        
    }
}
