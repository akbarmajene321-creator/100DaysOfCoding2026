import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Masukkan angka : ");
        int a = input.nextInt();

        int b = 1;
        for (int i = 2; i <= a; i++) {
            b *= i;
        }

        System.out.println(a + "! = " + b); 
        input.close();
    }
}
