import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner (System.in);
		
		System.out.print("Masukkan batas angka: ");
		int a = sc.nextInt();
		
		int b = 0;
		
		for (b = 1 ; b <= a ; b ++){
			System.out.println("Angka " + b);
		}
    }
}
